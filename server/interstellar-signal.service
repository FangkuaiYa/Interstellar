[Unit]
Description=Interstellar signalling server (P2P voice)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 可执行文件放哪就改哪
# 限额都用默认值：-max-clients 128（成本闸门）/ -rate 3500 / -burst 9000 / -max-bps 3000000
# 要放宽直接追加，例如：-listen :8090 -max-clients 256
ExecStart=/opt/interstellar/interstellar-signal-linux-amd64 -listen :8090
Restart=always
RestartSec=3
# 建议用独立低权限用户跑
User=interstellar
Group=interstellar
WorkingDirectory=/opt/interstellar

# 资源上限：信令服务器很轻，这些值足够一整个社区用
LimitNOFILE=65535
MemoryMax=256M
CPUQuota=50%

# 日志进 journald：journalctl -u interstellar-signal -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=interstellar-signal

# 加固：它只需要监听一个 TCP 端口
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/interstellar

[Install]
WantedBy=multi-user.target
